<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="DependentDropdownManager" constructor="DependentDropdownManager" version="0.0.1" display-name-key="DependentDropdownManager" description-key="DependentDropdownManager description" control-type="virtual" >
    <!--external-service-usage node declares whether this 3rd party PCF control is using external service or not, if yes, this control will be considered as premium and please also add the external domain it is using.
    If it is not using any external service, please set the enabled="false" and DO NOT add any domain below. The "enabled" will be false by default.
    Example1:
      <external-service-usage enabled="true">
        <domain>www.Microsoft.com</domain>
      </external-service-usage>
    Example2:
      <external-service-usage enabled="false">
      </external-service-usage>
    -->
    <external-service-usage enabled="false">
      <!--UNCOMMENT TO ADD EXTERNAL DOMAINS
      <domain></domain>
      <domain></domain>
      -->
    </external-service-usage>
    <!-- property node identifies a specific, configurable piece of data that the control expects from CDS -->
    <!--
    The Bound Value (The Child): The primary field the control is sitting on. This is where the final "State" gets saved.

    The Parent Field Name: The control needs the admin to type in the exact logical name of the "Country" field on the form, so the control knows which field to listen to for changes.

    The Child Table Name: The control needs to know which table to search (e.g., your "State" table) to find the list of options.

    The Linking Column Name: The control needs to know the exact logical name of the column inside the State table that points back to the Country table (the Lookup column you created).
    -->
    <property name="stateField" display-name-key="State_Field" description-key="State_Field_Description" of-type="Lookup.Simple" usage="bound" required="true" />

    <property name="countryFieldLogicalName" display-name-key="Country_Field_Logical_Name" description-key="Country_Field_Logical_Name_Description" of-type="SingleLine.Text" usage="input" required="true" />

    <property name="stateTableName" display-name-key="State_Table_Name" description-key="State_Table_Name_Description" of-type="SingleLine.Text" usage="input" required="true" />

    <property name="linkingColumnName" display-name-key="Linking_Column_Name" description-key="Linking_Column_Name_Description" of-type="SingleLine.Text" usage="input" required="true" />

    <property name="childOptionName" display-name-key="Child_Option_Name" description-key="Child_Option_Name_Description" of-type="SingleLine.Text" usage="input" required="true" />

    <!--
      Property node's of-type attribute can be of-type-group attribute.
      Example:
      <type-group name="numbers">
        <type>Whole.None</type>
        <type>Currency</type>
        <type>FP</type>
        <type>Decimal</type>
      </type-group>
      <property name="sampleProperty" display-name-key="Property_Display_Key" description-key="Property_Desc_Key" of-type-group="numbers" usage="bound" required="true" />
    -->
    <resources>
      <code path="index.ts" order="1"/>
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.0" />
      <!-- UNCOMMENT TO ADD MORE RESOURCES
      <css path="css/DependentDropdownManager.css" order="1" />
      <resx path="strings/DependentDropdownManager.1033.resx" version="1.0.0" />
      -->
    </resources>
    <feature-usage>
        <uses-feature name="WebAPI" required="true" />
    </feature-usage>
  </control>
</manifest>
